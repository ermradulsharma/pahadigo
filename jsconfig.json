{
    "compilerOptions": {
        "target": "ES6",
        "module": "esnext",
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "jsx": "preserve",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "paths": {
            "@/core/Controllers/*": [
                "./src/core/Http/Controllers/*"
            ],
            "@/core/Models/*": [
                "./src/core/Models/*"
            ],
            "@/core/Services/*": [
                "./src/core/Services/*"
            ],
            "@/core/Middleware/*": [
                "./src/core/Http/Middleware/*"
            ],
            "@/core/Routes/*": [
                "./src/core/Routes/*"
            ],
            "@/core/Config/*": [
                "./src/core/Config/*"
            ],
            "@/core/Helpers/*": [
                "./src/core/Helpers/*"
            ],
            "@/core/Constants/*": [
                "./src/core/Constants/*"
            ],
            "@/core/Seeders/*": [
                "./src/core/Database/Seeders/*"
            ],
            "@/core/Lib/*": [
                "./src/core/Lib/*"
            ],
            "@/controllers/*": [
                "./src/core/Http/Controllers/*"
            ],
            "@/models/*": [
                "./src/core/Models/*"
            ],
            "@/services/*": [
                "./src/core/Services/*"
            ],
            "@/helpers/*": [
                "./src/core/Helpers/*"
            ],
            "@/routes/*": [
                "./src/core/Routes/*"
            ],
            "@/config/*": [
                "./src/core/Config/*"
            ],
            "@/constants/*": [
                "./src/core/Constants/*"
            ],
            "@/seeders/*": [
                "./src/core/Database/Seeders/*"
            ],
            "@/lib/*": [
                "./src/core/Lib/*"
            ],
            "@/events/*": [
                "./src/core/Events/*"
            ],
            "@/components/*": [
                "./src/app/components/*"
            ],
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "index.js",
        "next.config.js"
    ],
    "exclude": [
        "node_modules",
        ".next",
        "out",
        "public/static",
        "dist"
    ],
    "typeAcquisition": {
        "enable": true,
        "exclude": [
            "d3-path",
            "request"
        ]
    }
}