        "@tailwindcss/postcss": "^4.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "autoprefixer": "^10.6.1",
        "chalk": "^6.0.1",
        "eslint": "^10.12.0",
        "eslint-config-next": "^16.4.0",
        "jest": "^30.5.2",
        "mongodb": "^7.7.0",
