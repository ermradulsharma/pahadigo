{
    "name": "pahadigo",
    "version": "3.1.0",
    "description": "Pahadigo - A modern travel and booking platform built with Next.js",
    "author": "ermradulsharma",
    "private": true,
    "type": "module",
    "repository": "https://github.com/ermradulsharma/pahadigo",
    "keywords": [
        "pahadigo",
        "travel",
        "booking",
        "himachal",
        "nextjs",
        "react"
    ],
    "sponsor": {
        "url": "https://github.com/sponsors/ermradulsharma"
    },
    "homepage": "https://pahadigo.co.in",
    "previewUrl": "https://pahadigo.vercel.app",
    "bugs": {
        "url": "https://github.com/ermradulsharma/pahadigo/issues"
    },
    "scripts": {
        "build": "next build",
        "dev": "next dev",
        "lint": "next lint .",
        "start": "next start",
        "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
        "clean": "del *.txt && del *.log",
        "seed": "node src/core/Database/Seeders/ResetAndSeed.js",
        "seed:mass": "node src/core/Database/Seeders/MassSeeder.js"
    },
    "dependencies": {
        "@react-pdf/renderer": "^4.8.1",
        "@upstash/qstash": "^2.11.3",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.3",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.1",
        "country-state-city": "^3.2.1",
        "find-my-way": "^9.9.0",
        "firebase-admin": "^14.3.0",
        "framer-motion": "^13.1.1",
        "google-auth-library": "^11.0.2",
        "js-cookie": "^3.0.8",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.34.0",
        "mongoose": "^9.9.4",
        "next": "^16.3.3",
        "nodemailer": "^9.0.5",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "razorpay": "^2.9.8",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-simple-wysiwyg": "^3.4.1",
        "recharts": "^3.10.1",
        "redis": "^6.2.1",
        "sharp": "^0.35.4",
        "tesseract.js": "^7.0.0",
        "uuid": "^14.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@jest/globals": "^30.4.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.3.0",
        "autoprefixer": "^10.5.4",
        "chalk": "^6.0.0",
        "eslint": "^10.9.1",
        "eslint-config-next": "^16.3.3",
        "jest": "^30.4.2",
        "mongodb": "^7.6.0",
        "mongodb-memory-server": "^11.2.0",
        "postcss": "^8.5.26",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.3.3",
        "nanoid": "^6.0.1"
    },
    "engines": {
        "node": ">=18.17.0",
        "npm": ">=9.0.0"
    },
    "overrides": {
        "nanoid": "$nanoid",
        "postcss": "$postcss",
        "uuid": "$uuid",
        "eslint": "$eslint",
        "sharp": "$sharp",
        "react-debounce-input": {
            "react": "$react",
            "react-dom": "$react-dom"
        },
        "react-inspector": {
            "react": "$react",
            "react-dom": "$react-dom"
        }
    },
    "allowScripts": {
        "@firebase/util@1.15.1": true,
        "mongodb-memory-server@11.2.0": true,
        "sharp@0.34.5": true,
        "sharp@0.35.3": true,
        "protobufjs@7.6.5": true,
        "tesseract.js@7.0.0": true,
        "unrs-resolver@1.12.2": true,
        "msgpackr-extract@3.0.4": true,
        "@scarf/scarf@1.4.0": true,
        "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
        "tree-sitter@0.22.4": true,
        "core-js-pure@3.50.0": true,
        "tree-sitter@0.21.1": true,
        "tree-sitter-json@0.24.8": true,
        "vue-demi@0.14.10": true
    }
}