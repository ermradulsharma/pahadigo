{
    "name": "pahadigo",
    "version": "3.1.0",
    "description": "Pahadigo - A modern travel and booking platform built with Next.js",
    "author": "Er. Mradul Sharma",
    "private": true,
    "type": "module",
    "repository": "https://github.com/ermradulsharma/pahadigo",
    "keywords": [
        "pahadigo",
        "Himachal Pradesh Tourism",
        "Manali Tour Packages",
        "Spiti Valley Trip",
        "Himachal Cab Rental",
        "Himachal Homestays",
        "Trekking in Himachal",
        "Kasol Camping",
        "travel-booking",
